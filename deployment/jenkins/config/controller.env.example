# Copy to the ignored config/local/controller.env and replace every value.
JENKINS_HTTP_PORT=8080
JENKINS_ADMIN_ID=replace-with-administrator-id
JENKINS_HANDOFF_ID=replace-with-machine-user-id
JENKINS_REPOSITORY_URL=https://github.com/replace/repository.git
JENKINS_AGENT_CONTROLLER_URL=http://controller:8080
JENKINS_PIPELINE_RUN_LIMIT_SECONDS=5400
JENKINS_COMPOSITION_WORK_LIMIT_SECONDS=600
JENKINS_IMAGE_BUILD_WORK_LIMIT_SECONDS=1800
JENKINS_CV_WORK_LIMIT_SECONDS=2700
JENKINS_CD_WORK_LIMIT_SECONDS=900
JENKINS_ADMIN_PASSWORD_FILE=/absolute/path/outside/checkout/admin-password
JENKINS_HANDOFF_PASSWORD_FILE=/absolute/path/outside/checkout/handoff-password
JENKINS_INTEGRATION_AGENT_SECRET_FILE=/absolute/path/outside/checkout/integration-agent-secret
JENKINS_CI_AGENT_SECRET_FILE=/absolute/path/outside/checkout/ci-agent-secret
JENKINS_IMAGE_BUILD_AGENT_SECRET_FILE=/absolute/path/outside/checkout/image-build-agent-secret
JENKINS_CV_AGENT_SECRET_FILE=/absolute/path/outside/checkout/cv-agent-secret
JENKINS_CD_AGENT_SECRET_FILE=/absolute/path/outside/checkout/cd-agent-secret
