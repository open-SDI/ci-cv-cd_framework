{
  "$defs": {
    "FixtureValidationRecord": {
      "additionalProperties": false,
      "description": "One declared validation case that was deliberately not evaluated.",
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evaluation_status": {
          "const": "not_evaluated",
          "title": "Evaluation Status",
          "type": "string"
        },
        "validation_case_id": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Validation Case Id",
          "type": "string"
        }
      },
      "required": [
        "validation_case_id",
        "description",
        "evaluation_status"
      ],
      "title": "FixtureValidationRecord",
      "type": "object"
    },
    "SourceInputDigest": {
      "additionalProperties": false,
      "description": "Stable exact-byte input correlation embedded in Domain outputs.",
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "slot": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Slot",
          "type": "string"
        }
      },
      "required": [
        "slot",
        "sha256"
      ],
      "title": "SourceInputDigest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Fixture-qualified CV handoff that contains no Validation verdict.",
  "properties": {
    "blueprint_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Blueprint Id",
      "type": "string"
    },
    "combination_id": {
      "pattern": "^C-[0-9]{2}$",
      "title": "Combination Id",
      "type": "string"
    },
    "deployment_schema_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Deployment Schema Id",
      "type": "string"
    },
    "domain_outcome": {
      "const": "not_evaluated",
      "title": "Domain Outcome",
      "type": "string"
    },
    "evidence_basis": {
      "const": "fixture",
      "title": "Evidence Basis",
      "type": "string"
    },
    "image_build_result_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Image Build Result Id",
      "type": "string"
    },
    "kpi_evaluation": {
      "const": "not_evaluated",
      "title": "Kpi Evaluation",
      "type": "string"
    },
    "profile_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Profile Id",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^S-[0-9]{2}$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "sdi.validation-evidence/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_inputs": {
      "items": {
        "$ref": "#/$defs/SourceInputDigest"
      },
      "maxItems": 5,
      "minItems": 5,
      "title": "Source Inputs",
      "type": "array"
    },
    "testcase_id": {
      "pattern": "^TC-[0-9]{2}$",
      "title": "Testcase Id",
      "type": "string"
    },
    "validation_evidence_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Validation Evidence Id",
      "type": "string"
    },
    "validation_records": {
      "items": {
        "$ref": "#/$defs/FixtureValidationRecord"
      },
      "minItems": 1,
      "title": "Validation Records",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "evidence_basis",
    "validation_evidence_id",
    "blueprint_id",
    "deployment_schema_id",
    "image_build_result_id",
    "scenario_id",
    "testcase_id",
    "combination_id",
    "profile_id",
    "source_inputs",
    "domain_outcome",
    "kpi_evaluation",
    "validation_records"
  ],
  "title": "ValidationEvidence",
  "type": "object"
}
