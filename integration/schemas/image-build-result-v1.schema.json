{
  "$defs": {
    "FixtureImageRecord": {
      "additionalProperties": false,
      "description": "One deterministic image reference without a build-success claim.",
      "properties": {
        "architecture": {
          "enum": [
            "arm64",
            "amd64"
          ],
          "title": "Architecture",
          "type": "string"
        },
        "build_status": {
          "const": "not_evaluated",
          "title": "Build Status",
          "type": "string"
        },
        "image": {
          "maxLength": 255,
          "pattern": "^[a-z0-9][a-z0-9._/-]*@sha256:[0-9a-f]{64}$",
          "title": "Image",
          "type": "string"
        },
        "service_id": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Service Id",
          "type": "string"
        }
      },
      "required": [
        "service_id",
        "architecture",
        "image",
        "build_status"
      ],
      "title": "FixtureImageRecord",
      "type": "object"
    },
    "SourceInputDigest": {
      "additionalProperties": false,
      "description": "Stable exact-byte input correlation embedded in Domain outputs.",
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "slot": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Slot",
          "type": "string"
        }
      },
      "required": [
        "slot",
        "sha256"
      ],
      "title": "SourceInputDigest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Fixture-qualified image-build handoff for one composition.",
  "properties": {
    "blueprint_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Blueprint Id",
      "type": "string"
    },
    "combination_id": {
      "pattern": "^C-[0-9]{2}$",
      "title": "Combination Id",
      "type": "string"
    },
    "deployment_schema_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Deployment Schema Id",
      "type": "string"
    },
    "evidence_basis": {
      "const": "fixture",
      "title": "Evidence Basis",
      "type": "string"
    },
    "image_build_result_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Image Build Result Id",
      "type": "string"
    },
    "images": {
      "items": {
        "$ref": "#/$defs/FixtureImageRecord"
      },
      "minItems": 1,
      "title": "Images",
      "type": "array"
    },
    "profile_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Profile Id",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^S-[0-9]{2}$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "sdi.image-build-result/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_inputs": {
      "items": {
        "$ref": "#/$defs/SourceInputDigest"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Source Inputs",
      "type": "array"
    },
    "testcase_id": {
      "pattern": "^TC-[0-9]{2}$",
      "title": "Testcase Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "evidence_basis",
    "image_build_result_id",
    "blueprint_id",
    "deployment_schema_id",
    "scenario_id",
    "testcase_id",
    "combination_id",
    "profile_id",
    "source_inputs",
    "images"
  ],
  "title": "ImageBuildResult",
  "type": "object"
}
