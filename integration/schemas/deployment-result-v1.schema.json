{
  "$defs": {
    "FixtureDeploymentRecord": {
      "additionalProperties": false,
      "description": "One intended placement that was deliberately not applied.",
      "properties": {
        "application_status": {
          "const": "not_evaluated",
          "title": "Application Status",
          "type": "string"
        },
        "location_id": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Location Id",
          "type": "string"
        },
        "service_id": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Service Id",
          "type": "string"
        }
      },
      "required": [
        "service_id",
        "location_id",
        "application_status"
      ],
      "title": "FixtureDeploymentRecord",
      "type": "object"
    },
    "SourceInputDigest": {
      "additionalProperties": false,
      "description": "Stable exact-byte input correlation embedded in Domain outputs.",
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "slot": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Slot",
          "type": "string"
        }
      },
      "required": [
        "slot",
        "sha256"
      ],
      "title": "SourceInputDigest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Fixture-qualified CD handoff that contains no deployment claim.",
  "properties": {
    "application_status": {
      "const": "not_evaluated",
      "title": "Application Status",
      "type": "string"
    },
    "blueprint_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Blueprint Id",
      "type": "string"
    },
    "combination_id": {
      "pattern": "^C-[0-9]{2}$",
      "title": "Combination Id",
      "type": "string"
    },
    "deployment_records": {
      "items": {
        "$ref": "#/$defs/FixtureDeploymentRecord"
      },
      "minItems": 1,
      "title": "Deployment Records",
      "type": "array"
    },
    "deployment_result_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Deployment Result Id",
      "type": "string"
    },
    "deployment_schema_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Deployment Schema Id",
      "type": "string"
    },
    "domain_outcome": {
      "const": "not_evaluated",
      "title": "Domain Outcome",
      "type": "string"
    },
    "evidence_basis": {
      "const": "fixture",
      "title": "Evidence Basis",
      "type": "string"
    },
    "image_build_result_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Image Build Result Id",
      "type": "string"
    },
    "profile_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Profile Id",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^S-[0-9]{2}$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "sdi.deployment-result/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_inputs": {
      "items": {
        "$ref": "#/$defs/SourceInputDigest"
      },
      "maxItems": 5,
      "minItems": 5,
      "title": "Source Inputs",
      "type": "array"
    },
    "testcase_id": {
      "pattern": "^TC-[0-9]{2}$",
      "title": "Testcase Id",
      "type": "string"
    },
    "validation_evidence_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Validation Evidence Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "evidence_basis",
    "deployment_result_id",
    "blueprint_id",
    "deployment_schema_id",
    "image_build_result_id",
    "validation_evidence_id",
    "scenario_id",
    "testcase_id",
    "combination_id",
    "profile_id",
    "source_inputs",
    "domain_outcome",
    "application_status",
    "deployment_records"
  ],
  "title": "DeploymentResult",
  "type": "object"
}
