        },
        "source": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "destination",
        "conditions"
      ],
      "title": "NetworkLink",
      "type": "object"
    },
    "NonNegativeQuantity": {
