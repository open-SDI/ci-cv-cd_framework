    "MobilityTarget": {
      "additionalProperties": false,
      "description": "The mobility target described by a reusable profile.",
      "properties": {
        "kind": {
          "enum": [
            "sdv",
            "sdr"
          ],
          "title": "Kind",
          "type": "string"
        },
        "target_id": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "kind"
      ],
      "title": "MobilityTarget",
      "type": "object"
    },
    "NetworkLink": {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "latency_ms"
          ]
        },
        {
          "required": [
            "bandwidth_mbps"
          ]
        }
      ],
      "description": "One directional network link under stated conditions.",
      "properties": {
        "bandwidth_mbps": {
          "discriminator": {
            "mapping": {
              "declared": "#/$defs/DeclaredValue_PositiveQuantity_",
              "measured": "#/$defs/MeasuredValue_PositiveQuantity_",
              "placeholder": "#/$defs/PlaceholderValue_PositiveQuantity_"
            },
            "propertyName": "basis"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PlaceholderValue_PositiveQuantity_"
            },
            {
              "$ref": "#/$defs/DeclaredValue_PositiveQuantity_"
            },
            {
              "$ref": "#/$defs/MeasuredValue_PositiveQuantity_"
            }
          ],
          "title": "Bandwidth Mbps"
        },
        "conditions": {
          "minLength": 1,
          "title": "Conditions",
          "type": "string"
        },
        "destination": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Destination",
          "type": "string"
        },
        "latency_ms": {
          "discriminator": {
            "mapping": {
              "declared": "#/$defs/DeclaredValue_NonNegativeQuantity_",
              "measured": "#/$defs/MeasuredValue_NonNegativeQuantity_",
              "placeholder": "#/$defs/PlaceholderValue_NonNegativeQuantity_"
            },
            "propertyName": "basis"
          },
