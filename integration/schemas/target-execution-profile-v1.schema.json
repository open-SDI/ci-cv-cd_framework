        "architecture": {
          "enum": [
            "arm64",
            "amd64"
          ],
          "title": "Architecture",
          "type": "string"
        },
        "kind": {
          "enum": [
            "native",
            "controller",
            "edge"
          ],
          "title": "Kind",
          "type": "string"
        },
        "platform_id": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Platform Id",
          "type": "string"
        }
      },
      "required": [
        "platform_id",
        "kind",
        "architecture"
      ],
      "title": "ComputePlatform",
      "type": "object"
    },
