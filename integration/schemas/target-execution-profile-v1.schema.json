    },
    "profile_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Profile Id",
      "type": "string"
    },
    "resources": {
      "$ref": "#/$defs/ResourceCapacity",
      "title": "Resources"
    },
    "schema_version": {
      "const": "sdi.target-execution-profile/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/MobilityTarget"
    }
