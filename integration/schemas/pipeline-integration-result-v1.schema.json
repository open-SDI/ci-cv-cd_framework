{
  "$defs": {
    "AcceptedAttemptEnvelope": {
      "additionalProperties": false,
      "description": "Transactional record created only after whole-bundle acceptance.",
      "properties": {
        "accepted_files": {
          "items": {
            "$ref": "#/$defs/AcceptedFile"
          },
          "title": "Accepted Files",
          "type": "array"
        },
        "accepted_inputs": {
          "items": {
            "$ref": "#/$defs/AcceptedInput"
          },
          "title": "Accepted Inputs",
          "type": "array"
        },
        "adapter_response_accepted": {
          "title": "Adapter Response Accepted",
          "type": "boolean"
        },
        "correlation": {
          "$ref": "#/$defs/Correlation"
        },
        "domain_outcome": {
          "$ref": "#/$defs/DomainOutcome"
        },
        "execution_conclusion": {
          "$ref": "#/$defs/ExecutionConclusion"
        },
        "implementation_mode": {
          "$ref": "#/$defs/ImplementationMode"
        },
        "lifecycle_state": {
          "enum": [
            "completed",
            "skipped"
          ],
          "title": "Lifecycle State",
          "type": "string"
        },
        "process": {
          "$ref": "#/$defs/ProcessFacts",
          "title": "Process"
        },
        "reason": {
          "$ref": "#/$defs/Reason"
        },
        "schema_version": {
          "const": "sdi.accepted-attempt-envelope/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "correlation",
        "lifecycle_state",
        "execution_conclusion",
        "implementation_mode",
        "domain_outcome",
        "adapter_response_accepted",
        "accepted_inputs",
        "accepted_files"
      ],
      "title": "AcceptedAttemptEnvelope",
      "type": "object"
    },
    "AcceptedDiagnosticFile": {
      "additionalProperties": false,
      "description": "One bounded sanitized diagnostic accepted by the integration runtime.",
      "properties": {
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "const": "text/plain; charset=utf-8",
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\x00-\\x1f\\x7f]).*[^/]$",
          "title": "Path",
          "type": "string"
        },
        "role": {
          "const": "diagnostic",
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "slot": {
          "const": "diagnostic",
          "title": "Slot",
          "type": "string"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "role",
        "slot",
        "path",
        "media_type",
        "byte_size",
        "sha256",
        "truncated"
      ],
      "title": "AcceptedDiagnosticFile",
      "type": "object"
    },
    "AcceptedDomainFile": {
      "additionalProperties": false,
      "description": "One schema-valid Domain file accepted by the integration runtime.",
      "properties": {
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\x00-\\x1f\\x7f]).*[^/]$",
          "title": "Path",
          "type": "string"
        },
        "role": {
          "const": "domain_output",
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "slot": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Slot",
          "type": "string"
        }
      },
      "required": [
        "role",
        "slot",
        "path",
        "media_type",
        "schema_version",
        "byte_size",
        "sha256"
      ],
      "title": "AcceptedDomainFile",
      "type": "object"
    },
    "AcceptedFile": {
      "discriminator": {
        "mapping": {
          "diagnostic": "#/$defs/AcceptedDiagnosticFile",
          "domain_output": "#/$defs/AcceptedDomainFile"
        },
        "propertyName": "role"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AcceptedDomainFile"
        },
        {
          "$ref": "#/$defs/AcceptedDiagnosticFile"
        }
      ]
    },
    "AcceptedInput": {
      "additionalProperties": false,
      "description": "Exact declared input accepted for this attempt.",
      "properties": {
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "slot": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Slot",
          "type": "string"
        },
        "source_path": {
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\x00-\\x1f\\x7f]).*[^/]$",
          "title": "Source Path",
          "type": "string"
        }
      },
      "required": [
        "slot",
        "source_path",
        "schema_version",
        "byte_size",
        "sha256"
      ],
      "title": "AcceptedInput",
      "type": "object"
    },
    "BundleArtifact": {
      "discriminator": {
        "mapping": {
          "diagnostic": "#/$defs/BundleDiagnosticArtifact",
          "domain_output": "#/$defs/BundleDomainArtifact"
        },
        "propertyName": "role"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/BundleDomainArtifact"
        },
        {
          "$ref": "#/$defs/BundleDiagnosticArtifact"
        }
      ]
    },
    "BundleDiagnosticArtifact": {
      "additionalProperties": false,
      "description": "One bounded sanitized diagnostic included in the archive candidate.",
      "properties": {
        "byte_size": {
          "maximum": 4096,
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "const": "text/plain; charset=utf-8",
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\x00-\\x1f\\x7f]).*[^/]$",
          "title": "Path",
          "type": "string"
        },
        "role": {
          "const": "diagnostic",
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "slot": {
          "const": "diagnostic",
          "title": "Slot",
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/StageName"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "role",
        "stage",
        "slot",
        "path",
        "media_type",
        "byte_size",
        "sha256",
        "truncated"
      ],
      "title": "BundleDiagnosticArtifact",
      "type": "object"
    },
    "BundleDomainArtifact": {
      "additionalProperties": false,
      "description": "One schema-valid Domain output included in the archive candidate.",
      "properties": {
        "byte_size": {
          "maximum": 32768,
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\x00-\\x1f\\x7f]).*[^/]$",
          "title": "Path",
          "type": "string"
        },
        "role": {
          "const": "domain_output",
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "slot": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Slot",
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/StageName"
        }
      },
      "required": [
        "role",
        "stage",
        "slot",
        "path",
        "media_type",
        "schema_version",
        "byte_size",
        "sha256"
      ],
      "title": "BundleDomainArtifact",
      "type": "object"
    },
    "Correlation": {
      "additionalProperties": false,
      "description": "Stable project correlation carried across one Stage attempt.",
      "properties": {
        "attempt_number": {
          "exclusiveMinimum": 0,
          "title": "Attempt Number",
          "type": "integer"
        },
        "execution_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Execution Id",
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/StageName"
        }
      },
      "required": [
        "execution_id",
        "stage",
        "attempt_number"
      ],
      "title": "Correlation",
      "type": "object"
    },
    "DomainOutcome": {
      "enum": [
        "succeeded",
        "failed",
        "not_evaluated"
      ],
      "type": "string"
    },
    "ExecutionConclusion": {
      "enum": [
        "succeeded",
        "failed",
        "timed_out",
        "skipped"
      ],
      "type": "string"
    },
    "ImplementationMode": {
      "enum": [
        "fixture",
        "implemented",
        "not_implemented"
      ],
      "type": "string"
    },
    "ProcessFacts": {
      "additionalProperties": false,
      "description": "Authoritative process observations recorded by the runtime.",
      "properties": {
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exit Code"
        },
        "finished_at": {
          "format": "date-time",
          "title": "Finished At",
          "type": "string"
        },
        "signal": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Signal"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "termination": {
          "enum": [
            "exited",
            "signaled",
            "timed_out",
            "lost"
          ],
          "title": "Termination",
          "type": "string"
        }
      },
      "required": [
        "started_at",
        "finished_at",
        "duration_ms",
        "termination"
      ],
      "title": "ProcessFacts",
      "type": "object"
    },
    "Reason": {
      "additionalProperties": false,
      "description": "Bounded, sanitized process or Domain reason.",
      "properties": {
        "category": {
          "enum": [
            "fixture",
            "input",
            "dependency",
            "tool",
            "adapter",
            "domain"
          ],
          "title": "Category",
          "type": "string"
        },
        "code": {
          "maxLength": 127,
          "pattern": "^sdi\\.[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$",
          "title": "Code",
          "type": "string"
        },
        "summary": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "category",
        "code",
        "summary"
      ],
      "title": "Reason",
      "type": "object"
    },
    "ResultInputProvenance": {
      "additionalProperties": false,
      "description": "Exact committed bytes that identified the Pipeline integration run.",
      "properties": {
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "path": {
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\x00-\\x1f\\x7f]).*[^/]$",
          "title": "Path",
          "type": "string"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "schema_version",
        "byte_size",
        "sha256"
      ],
      "title": "ResultInputProvenance",
      "type": "object"
    },
    "StageName": {
      "enum": [
        "composition",
        "image_build",
        "cv",
        "cd"
      ],
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Complete Fixture result and inventory for one supported combination.",
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/BundleArtifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "attempts": {
      "items": {
        "$ref": "#/$defs/AcceptedAttemptEnvelope"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Attempts",
      "type": "array"
    },
    "combination_id": {
      "pattern": "^C-[0-9]{2}$",
      "title": "Combination Id",
      "type": "string"
    },
    "duration_ms": {
      "minimum": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "execution_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Execution Id",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "fixture_notice": {
      "const": "Deterministic pipeline-interface Fixtures may have simulated outcomes; no real Domain capability, Validation verdict, deployment outcome, or KPI was evaluated.",
      "title": "Fixture Notice",
      "type": "string"
    },
    "input_provenance": {
      "items": {
        "$ref": "#/$defs/ResultInputProvenance"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Input Provenance",
      "type": "array"
    },
    "kpi_evaluation": {
      "const": "not_evaluated",
      "title": "Kpi Evaluation",
      "type": "string"
    },
    "profile_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Profile Id",
      "type": "string"
    },
    "repository": {
      "pattern": "^github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "title": "Repository",
      "type": "string"
    },
    "requested_ref": {
      "const": "refs/heads/main",
      "title": "Requested Ref",
      "type": "string"
    },
    "resolved_commit_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Resolved Commit Sha",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^S-[0-9]{2}$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "sdi.pipeline-integration-result/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "testcase_id": {
      "pattern": "^TC-[0-9]{2}$",
      "title": "Testcase Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "execution_id",
    "repository",
    "requested_ref",
    "resolved_commit_sha",
    "scenario_id",
    "testcase_id",
    "combination_id",
    "profile_id",
    "started_at",
    "finished_at",
    "duration_ms",
    "input_provenance",
    "attempts",
    "artifacts",
    "fixture_notice",
    "kpi_evaluation"
  ],
  "title": "PipelineIntegrationResult",
  "type": "object"
}
