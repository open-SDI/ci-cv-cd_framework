{
  "$defs": {
    "RunCombination": {
      "additionalProperties": false,
      "description": "The one testcase-local combination selected by a run request.",
      "properties": {
        "combination_id": {
          "pattern": "^C-[0-9]{2}$",
          "title": "Combination Id",
          "type": "string"
        },
        "target_profile": {
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\x00-\\x1f\\x7f]).*[^/]$",
          "title": "Target Profile",
          "type": "string"
        }
      },
      "required": [
        "combination_id",
        "target_profile"
      ],
      "title": "RunCombination",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One committed pipeline integration run request.",
  "properties": {
    "combination": {
      "$ref": "#/$defs/RunCombination"
    },
    "requirements_specification": {
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\x00-\\x1f\\x7f]).*[^/]$",
      "title": "Requirements Specification",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^S-[0-9]{2}$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "sdi.pipeline-integration-run-request/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "testcase_id": {
      "pattern": "^TC-[0-9]{2}$",
      "title": "Testcase Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "testcase_id",
    "requirements_specification",
    "combination"
  ],
  "title": "RunRequest",
  "type": "object"
}
